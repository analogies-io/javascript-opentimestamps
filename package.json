{
  "name": "opentimestamps",
  "version": "0.4.9",
  "description": "JS Porting of OpenTimestamps",
  "main": "index.js",
  "types": "index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "standard": "^13.1.0",
    "tape": "^4.11.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "tape test/*.js && standard ./src/*.js ./test/*.js ./test/helpers/*.js && npm run test:types",
